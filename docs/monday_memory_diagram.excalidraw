      "text": "Used for Caching Common Queries",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Used for Caching Common Queries",
      "autoResize": false,
