      "isDeleted": false,
      "boundElements": null,
      "updated": 1761182531868,
      "link": null,
      "locked": false,
      "text": "If we have \nan actual user,\nwe can pass\nthat down to\nthe memory\nservice for use\nlater",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If we have \nan actual user,\nwe can pass that down to the memory service for use later",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "X3Me87hTf-67sx3lRzywk",
      "type": "text",
      "x": -498.39803991348174,
      "y": 539.1578527887241,
      "width": 250.75936477201617,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0N",
      "roundness": null,
      "seed": 1782649608,
      "version": 144,
      "versionNonce": 836266504,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1761182332492,
      "link": null,
      "locked": false,
      "text": "Occassionally,\nwe're going to\nneed to\nrotate our\nJWT tokens.\nThis task\nhelps us with\nthat.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Occassionally, we're going to need to rotate our JWT tokens. This task helps us with that.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "j_WmovicfTTnjHGIB7WAL",
      "type": "text",
      "x": 1543.51041983698,
      "y": 1131.3846773491082,
      "width": 450.54998779296875,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 1859939960,
      "version": 269,
      "versionNonce": 853306120,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1761182559195,
      "link": null,
      "locked": false,
      "text": "If we don't have\na User, it means that we \nhave a guest instead.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If we don't have\na User, it means that we \nhave a guest instead.",
      "autoResize": true,
      "lineHeight": 1.25
    },
