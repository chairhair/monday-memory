    {
      "id": "WGzSE-5iit1_BH2qLOjaM",
      "type": "text",
      "x": -25.30192274018043,
      "y": 1574.063818647613,
      "width": 621.5666809082031,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
