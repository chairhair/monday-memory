      "isDeleted": false,
      "boundElements": [],
      "updated": 1761183232263,
      "link": null,
      "locked": false,
      "text": "Used for Caching Common Queries",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Used for Caching Common Queries",
      "autoResize": false,
